# Local HTTP server. Start with: node --env-file=.env server.js
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Fill in to enable the administration API.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional local PostgreSQL connection for shared state.
DATABASE_URL=

# Configure BDayBot, Travel Radar and payments for your own environment.
# See docs/operations.md for variable names and setup.
