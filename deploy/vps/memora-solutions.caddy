{
    servers {
        # Cloudflare publishes these origin ranges at cloudflare.com/ips. Caddy
        # accepts visitor IP headers only from those peers; direct requests keep
        # their socket address, so public rate limits cannot be spoofed.
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP X-Forwarded-For
    }
}

(memora_site) {
    log {
        output file /var/log/caddy/memora-access.log {
            roll_size 20MiB
            roll_keep 5
        }
        format json
    }

    # Cloudflare caches versioned resources and keeps HTML/API traffic on the
    # same public origin, so browser security policies see one trusted host.
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
    }
    reverse_proxy 127.0.0.1:3020 {
        # Node получает только проверенный Caddy адрес посетителя.
        header_up -CF-Connecting-IP
        header_up X-Forwarded-For {client_ip}
    }
}

# Keep :8443 during the Cloudflare-to-direct DNS transition. Both listeners use
# the same publicly trusted certificate once the apex record resolves to the VPS.
memorasolutions.ru, memorasolutions.ru:8443 {
    import memora_site
}

# The admin hostname uses direct DNS and a publicly trusted certificate.
admin.memorasolutions.ru, admin.memorasolutions.ru:8443 {
    import memora_site
}

# Cloudflare sends the sport-poker hostname to the origin HTTPS listener on 8443.
poker.memorasolutions.ru:8443 {
    tls internal

    @poker_ws path /ws /ws/*
    reverse_proxy @poker_ws 127.0.0.1:3011

    reverse_proxy 127.0.0.1:3010
}
