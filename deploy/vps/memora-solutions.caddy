(memora_site) {
    log {
        output file /var/log/caddy/memora-access.log {
            roll_size 20MiB
            roll_keep 5
        }
        format json
    }

    # The VPS keeps HTML and API requests close to the database. Static files
    # use the GitHub Pages edge network, which reliably delivers larger media
    # across mobile and desktop providers.
    @public_assets path_regexp public_assets (?i)\.(?:avif|css|gif|ico|jpe?g|js|json|mp3|mp4|ogg|png|svg|webm|webp|woff2?)$
    redir @public_assets https://arar228.github.io/memora-solutions{uri} 307

    reverse_proxy 127.0.0.1:3020
}

# Keep :8443 during the Cloudflare-to-direct DNS transition. Both listeners use
# the same publicly trusted certificate once the apex record resolves to the VPS.
memorasolutions.ru, memorasolutions.ru:8443 {
    import memora_site
}

# The admin hostname uses direct DNS and a publicly trusted certificate.
admin.memorasolutions.ru, admin.memorasolutions.ru:8443 {
    import memora_site
}

# Cloudflare sends the sport-poker hostname to the origin HTTPS listener on 8443.
poker.memorasolutions.ru:8443 {
    tls internal

    @poker_ws path /ws /ws/*
    reverse_proxy @poker_ws 127.0.0.1:3011

    reverse_proxy 127.0.0.1:3010
}
