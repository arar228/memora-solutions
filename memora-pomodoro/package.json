{
    "name": "memora-pomodoro",
    "version": "1.4.2",
    "description": "Minimalist cross-platform Pomodoro timer by Memora Solutions",
    "author": "Memora Solutions <s.maklakov@armk.pro>",
    "license": "MIT",
    "main": "dist/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "build:public": "node scripts/build-public.cjs desktop",
        "build:web:public": "node scripts/build-public.cjs web",
        "preview:public": "node scripts/build-public.cjs preview",
        "preview": "electron-vite preview",
        "pack": "electron-vite build && electron-builder --dir",
        "dist": "electron-vite build && electron-builder",
        "dist:win": "electron-vite build && electron-builder --win",
        "dist:mac": "electron-vite build && electron-builder --mac",
        "dist:linux": "electron-vite build && electron-builder --linux",
        "build:web": "vite build --config vite.web.config.ts && node ../scripts/check-pomodoro-assets.mjs",
        "protect:scene": "node scripts/protect-scene.cjs"
    },
    "dependencies": {
        "iconv-lite": "^0.7.3",
        "sql.js": "^1.10.0"
    },
    "devDependencies": {
        "@fontsource/outfit": "^5.2.8",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^5.1.1",
        "electron": "^44.0.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "png-to-ico": "^3.0.1",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "typescript": "^5.5.0",
        "vite": "^7.3.6"
    },
    "overrides": {
        "@babel/core": "7.29.7",
        "nanoid": "3.3.18",
        "postcss": "8.5.26"
    }
}
