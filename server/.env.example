# Memora Concierge API — environment.
# Copy to .env and fill in. Without YooKassa keys the API runs in MOCK payment
# mode (full flow demoable locally without a real merchant account).

PORT=4000
PUBLIC_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# Where the client returns after paying.
PAYMENT_RETURN_URL=http://localhost:5173/travel-radar-v2

# YooKassa (use a TEST shop first). Leave empty to stay in MOCK mode.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# DB path (SQLite for Phase 1). For production, swap to PostgreSQL.
# DB_PATH=./data/concierge.db

# 32-byte hex key for at-rest encryption of uploaded documents (152-ФЗ).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; a dev key is derived from JWT_SECRET otherwise.
DOC_ENCRYPTION_KEY=
